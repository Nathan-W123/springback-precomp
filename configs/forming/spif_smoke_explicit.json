// Single-point incremental forming, smoke case, explicit forming (docs/forming.md,
// "Explicit forming"): configs/forming/spif_smoke.json with its `form` and
// `retract` steps integrated by central differences (`form_explicit`) - the
// tool travelling along its path at 0.5 m/s, the mass scaled selectively to a
// 1 us time step (an equivalent speed v sqrt(s) of 7 m/s, the recommended
// setting of docs/forming.md, section 7.3; the mass is scaled by about 200,
// which the run warns about) - and the springback released
// implicitly onto the same 3-2-1 supports. The same 40 x 40 x 1 mm blank
// (20 x 20 x 2 Hex8), 5 mm tool and two contours to 2 mm
// (spif_smoke_toolpath.csv). docs/forming.md, section 7.3, compares a run of
// it with one of spif_smoke.json.
{
  "name": "spif_smoke_explicit",
  "description": "SPIF smoke case, explicit forming: 40 x 40 x 1 mm blank, 5 mm tool, 2 contours to 2 mm, retract, unclamp",
  "mesh": { "type": "structured_hex", "nx": 20, "ny": 20, "nz": 2,
            "lx": 0.04, "ly": 0.04, "lz": 0.001, "x0": -0.02, "y0": -0.02, "z0": -0.001 },
  "material": { "name": "AA1050-like", "youngs_modulus": 70.0e9, "poisson_ratio": 0.33,
                "density": 2700.0,
                "plasticity": { "yield_stress": 100.0e6, "hardening_modulus": 300.0e6 } },
  "forming": {
    "kinematics": "finite",
    "tools": [
      { "name": "tool", "shape": "sphere", "radius": 0.005,
        "surface": { "box": { "zmin": 0.0 } },
        "friction": 0.05, "penalty": 10.0,
        "trajectory": { "file": "spif_smoke_toolpath.csv" } }
    ],
    "steps": [
      { "name": "form", "type": "form_explicit", "tools": ["tool"], "time": [0.0, 3.1],
        "explicit": { "tool_speed": 0.5,
                      "mass_scaling": { "mode": "selective", "target_time_step": 1.0e-6 },
                      "history_every": 100 },
        "boundary_conditions": [
          { "name": "frame", "fix": ["x", "y", "z"], "mode": "hold",
            "region": { "any_of": [ { "box": { "xmax": -0.015 } }, { "box": { "xmin": 0.015 } },
                                    { "box": { "ymax": -0.015 } }, { "box": { "ymin": 0.015 } } ] } } ] },
      { "name": "retract", "type": "form_explicit", "tools": ["tool"], "time": [3.1, 3.2],
        "explicit": { "tool_speed": 0.5,
                      "mass_scaling": { "mode": "selective", "target_time_step": 1.0e-6 },
                      "history_every": 100 },
        "boundary_conditions": [
          { "name": "frame", "fix": ["x", "y", "z"], "mode": "hold",
            "region": { "any_of": [ { "box": { "xmax": -0.015 } }, { "box": { "xmin": 0.015 } },
                                    { "box": { "ymax": -0.015 } }, { "box": { "ymin": 0.015 } } ] } } ] },
      { "name": "unclamp", "type": "release", "increments": 10,
        "boundary_conditions": [
          { "name": "A", "fix": ["x", "y", "z"], "region": { "nearest_node": [-0.02, -0.02, 0.0] } },
          { "name": "B", "fix": ["y", "z"], "region": { "nearest_node": [0.02, -0.02, 0.0] } },
          { "name": "C", "fix": ["z"], "region": { "nearest_node": [-0.02, 0.02, 0.0] } } ] }
    ],
    "newton": { "max_iterations": 30, "residual_tolerance": 1.0e-6, "line_search": true,
                "max_cuts": 10 },
    "output": { "vtk": true, "snapshots": "steps" }
  }
}
