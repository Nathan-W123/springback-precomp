// Single-point incremental forming, smoke case (docs/forming.md): a 40 mm x
// 40 mm x 1 mm aluminium blank (Hex8, 20 x 20 x 2, mean dilatation) clamped
// on a 5 mm frame, formed by a 5 mm radius sphere along two contour levels
// to 2 mm depth (spif_smoke_toolpath.csv, written by
// make_forming_toolpath.py --tool-radius 0.005 --radius 0.008 --dr 0.001
// --dz 0.001 --levels 2 --segments 24; the script is in the history at commit
// 7d571e6), the tool retracted, the blank unclamped onto 3-2-1 supports at
// three corners.
{
  "name": "spif_smoke",
  "description": "SPIF smoke case: 40 x 40 x 1 mm blank, 5 mm tool, 2 contours to 2 mm, retract, unclamp",
  "mesh": { "type": "structured_hex", "nx": 20, "ny": 20, "nz": 2,
            "lx": 0.04, "ly": 0.04, "lz": 0.001, "x0": -0.02, "y0": -0.02, "z0": -0.001 },
  "material": { "name": "AA1050-like", "youngs_modulus": 70.0e9, "poisson_ratio": 0.33,
                "density": 2700.0,
                "plasticity": { "yield_stress": 100.0e6, "hardening_modulus": 300.0e6 } },
  "forming": {
    "kinematics": "finite",
    "tools": [
      { "name": "tool", "shape": "sphere", "radius": 0.005,
        "surface": { "box": { "zmin": 0.0 } },
        "friction": 0.05, "penalty": 10.0,
        "trajectory": { "file": "spif_smoke_toolpath.csv" } }
    ],
    "steps": [
      { "name": "form", "type": "form", "tools": ["tool"], "time": [0.0, 3.1],
        "max_tool_travel": 1.0e-3,
        "boundary_conditions": [
          { "name": "frame", "fix": ["x", "y", "z"], "mode": "hold",
            "region": { "any_of": [ { "box": { "xmax": -0.015 } }, { "box": { "xmin": 0.015 } },
                                    { "box": { "ymax": -0.015 } }, { "box": { "ymin": 0.015 } } ] } } ] },
      { "name": "retract", "type": "form", "tools": ["tool"], "time": [3.1, 3.2],
        "max_tool_travel": 1.0e-3,
        "boundary_conditions": [
          { "name": "frame", "fix": ["x", "y", "z"], "mode": "hold",
            "region": { "any_of": [ { "box": { "xmax": -0.015 } }, { "box": { "xmin": 0.015 } },
                                    { "box": { "ymax": -0.015 } }, { "box": { "ymin": 0.015 } } ] } } ] },
      { "name": "unclamp", "type": "release", "increments": 10,
        "boundary_conditions": [
          { "name": "A", "fix": ["x", "y", "z"], "region": { "nearest_node": [-0.02, -0.02, 0.0] } },
          { "name": "B", "fix": ["y", "z"], "region": { "nearest_node": [0.02, -0.02, 0.0] } },
          { "name": "C", "fix": ["z"], "region": { "nearest_node": [-0.02, 0.02, 0.0] } } ] }
    ],
    "newton": { "max_iterations": 30, "residual_tolerance": 1.0e-6, "line_search": true,
                "max_cuts": 10 },
    "output": { "vtk": true, "snapshots": "steps" }
  }
}
